{
  "name": "klaxo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KLAXO — jeu 2D solo en monde ouvert, satirique, jouable dans le navigateur (PWA hors ligne).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/build-sw.mjs",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "weekly": "tsx tools/weekly/generate.ts",
    "validate:data": "tsx tools/validate-data.ts",
    "icons": "node tools/make-icons.mjs",
    "schemas": "tsx tools/make-schemas.ts",
    "build:single": "node tools/make-single.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.17.1",
    "playwright": "1.56.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
